# Réglages de mise en ligne. Copier ce fichier sous le nom « .env.local », puis adapter les deux lignes.
# Ils sont lus par « npm run build ».

# Adresse du site, sans barre finale. Elle sert aux aperçus de lien (WhatsApp, Facebook) et au plan du site.
NEXT_PUBLIC_SITE_URL=https://college-tomi-fidele.netlify.app

# « false » : le site reste hors de Google (phase de test). « true » : il peut y apparaître.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Back-office (Supabase) : adresse du projet et clé publique (« publishable »), dans Supabase > Project Settings > API Keys.
# Sans ces deux lignes, le site se construit avec les fichiers content/data/*.json et /admin affiche « non reliée ».
NEXT_PUBLIC_SUPABASE_URL=https://tgumhayaxrtmvevghyro.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_PjSWwUYbEROrE5HSxFf4MQ_0J6CnjQj

# Si la base ne répond pas pendant la construction, la construction s'arrête (la version en ligne reste).
# Mettre 1 pour construire quand même avec les fichiers du projet.
# PULL_CONTENT_OPTIONAL=1
